{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build C++",
            "type": "shell",
            "command": "clang++",
            "args": [
                "-g",
                "-std=c++23",
                "${workspaceFolder}/src/cpp/*.cpp",
                "-I${workspaceFolder}/src/hdr",
                "-o",
                "${workspaceFolder}/build/a.out"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}